#!/bin/bash

# START USAGE DOCUMENTATION
# refresh_sso is a command line tool to refresh all AWS SSO / Identity Center sessions.
# It finds all [sso-session <name>] sections in ~/.aws/config with a single fast
# awk pass (no per-profile aws CLI calls) and runs 'aws sso login' on each of them.
# Does not modify AWS_PROFILE or AWS_REGION.
#
# Usage: refresh_sso
#
# END USAGE DOCUMENTATION

set -eo pipefail

# Colors
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

CONFIG_FILE="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

if ! hash aws 2>/dev/null; then
  echo -e "${RED}refresh_sso requires 'aws' to be installed${NC}" >&2
  exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo -e "${RED}AWS config file not found: $CONFIG_FILE${NC}" >&2
  exit 1
fi

# Single-pass awk: extract the names of all [sso-session <name>] sections.
# Instant, unlike calling 'aws configure get' once per profile.
sso_sessions=()
while IFS= read -r session; do
  sso_sessions+=("$session")
done < <(awk '/^\[sso-session / { name=$0; sub(/^\[sso-session /, "", name); sub(/\].*$/, "", name); print name }' "$CONFIG_FILE")

if [[ ${#sso_sessions[@]} -eq 0 ]]; then
  echo -e "${YELLOW}No [sso-session] sections found in $CONFIG_FILE${NC}"
  exit 0
fi

echo -e "${GREEN}Found ${#sso_sessions[@]} SSO session(s) in $CONFIG_FILE:${NC}"
for session in "${sso_sessions[@]}"; do
  echo "  - $session"
done
echo ""

success=0
failed=0
failed_sessions=()
total=${#sso_sessions[@]}

for session in "${sso_sessions[@]}"; do
  echo -e "${YELLOW}[$((success + failed + 1))/$total] Logging into SSO session '$session' - complete the login in your browser${NC}"
  if aws sso login --sso-session "$session"; then
    echo -e "${GREEN}✓ $session${NC}"
    success=$((success + 1))
  else
    echo -e "${RED}✗ $session${NC}"
    failed=$((failed + 1))
    failed_sessions+=("$session")
  fi
  echo ""
done

if [[ $failed -gt 0 ]]; then
  echo -e "${RED}Done. Success: $success, Failed: $failed${NC}"
  echo -e "${RED}Failed sessions: ${failed_sessions[*]}${NC}"
  exit 1
else
  echo -e "${GREEN}Done. Success: $success, Failed: $failed${NC}"
fi